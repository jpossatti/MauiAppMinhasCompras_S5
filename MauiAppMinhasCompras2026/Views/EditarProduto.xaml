<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras2026.Views.EditarProduto"
             Title="Editar Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Descrição do Produto:" FontAttributes="Bold" />
        <Entry x:Name="txt_descricao"
               Text="{Binding Descricao}"
               Placeholder="Digite a descrição" />

        <Label Text="Quantidade:" FontAttributes="Bold" />
        <Entry x:Name="txt_quantidade"
               Text="{Binding Quantidade}"
               Keyboard="Numeric"
               Placeholder="Digite a quantidade" />

        <Label Text="Preço Unitário:" FontAttributes="Bold" />
        <Entry x:Name="txt_preco"
               Text="{Binding Preco}"
               Keyboard="Numeric"
               Placeholder="Digite o preço" />

    </VerticalStackLayout>
</ContentPage>